#: ../../source/index.rst:-1 ../../source/index.rst:67
#: 7603a17f46f24f8f9e8c496f16c178c3 a2b517ba96644ae1b9a17695877e7e73
msgid "Algorithmic Trading in Python with Machine Learning"
msgstr "利用 Python 和机器学习助力算法交易"

#: ../../source/index.rst:-1 80652ba44a8b4938b4afc26dd5aee65c
msgid "XJpTXQaAdlEb2eAbndHa2ZmaUiOixSMaRusk-kKVKOQ"
