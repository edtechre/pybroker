#: 1c1ae44731be41cf8a3484e0157ae591 c616a0efcc1046ca89acb1212c46db1e
msgid "Algorithmic Trading in Python with Machine Learning"
msgstr "利用 Python 和机器学习助力算法交易"

#: ../../source/index.rst:-1 33ae72045582496485e1d1ef4033c6d9
msgid "XJpTXQaAdlEb2eAbndHa2ZmaUiOixSMaRusk-kKVKOQ"
