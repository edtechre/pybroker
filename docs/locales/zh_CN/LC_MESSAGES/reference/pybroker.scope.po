#: 0a86e1f1c6f54c74ba6d578c34f456c3 of
#: pybroker.scope.IntervalScope.clear_cache:1
msgid "Drops every cached array."
msgstr ""

#: 18f6c513482c4e3aacc2a420d3f266b1 of
#: pybroker.scope.IntervalScope.clear_cache:3
msgid ""
"Compressed data is immutable for the lifetime of a scope (a new one is "
"built per walkforward window), and each cache is keyed independently of "
"the current bar, so this is only for tearing a scope down -- calling it "
"per bar would rebuild model input and rerun ``predict`` on every bar."
msgstr ""

#: 9b8f869ba39e475280af6c87cde82206 of
#: pybroker.scope.IntervalScope.window_len:1
msgid "Returns the compressed bar count visible in the current window."
msgstr ""

#: d780fb765e184dcb8075e4833d295250 of
#: pybroker.scope.IntervalScope.window_len:3
msgid ""
"``completed`` is realigned to the walkforward test window by "
":meth:`pybroker.interval.IntervalData.slice_for_test`, so its last entry "
"is the newest compressed bar that completes within the window. Model "
"input and predictions are capped here so user callbacks never see "
"compressed bars belonging to a future window."
msgstr ""

