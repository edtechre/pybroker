#: 5b5b0d0e909b494ab01aefd53e62fc1e of
#: pybroker.scope.symbol_array_store_from_indexed_df:1
msgid "Builds a :class:`SymbolArrayStore` from a sorted MultiIndex frame."
msgstr "从已排序的 MultiIndex 数据帧构建 :class:`SymbolArrayStore`。"

#: b2ea7f7321f1428fb207aa0caeaeaafb of pybroker.scope.unregister_columns:1
