msgstr "随机自助法指标。"

#: 8c1e8e72615b4183b1ab6080560f9bb0 of pybroker.eval.EvalResult:13
msgid "pybroker.eval.BootstrapResult | None"
msgstr "pybroker.eval.BootstrapResult | None"

