#: e99b2719d05643b4b155ca7cd40bc02a ff78d21426904c24a87616d4e9f1bc49
msgid "Returns"
msgstr "返回"

#: efe1d6134f4a41f68af8d39cc4b66d07 of
#: pybroker.context.ExecContext.calc_target_shares:18
msgid ""
"Number of shares given ``target_size`` and share ``price``. If "
":attr:`pybroker.config.StrategyConfig.enable_fractional_shares` is "
"``True``, then a Decimal is returned."
msgstr ""
"根据 ``target_size`` 和股票 ``price`` 计算出的股数。如果 "
":attr:`pybroker.config.StrategyConfig.enable_fractional_shares` 为 "
"``True``，则返回一个 Decimal。"

#: 2b1928de7818470daa1ca1b5faa29a44 of
#: pybroker.context.ExecContext.cancel_all_pending_orders:1
msgid ""
"Cancels all :class:`pybroker.scope.PendingOrder`\\ s for ``symbol``. When"
" ``symbol`` is ``None``, all pending orders are canceled."
msgstr ""
"取消 ``symbol`` 的所有 :class:`pybroker.scope.PendingOrder`\\。当 ``symbol`` 为 "
"``None`` 时，取消所有待处理订单。"

#: c2bed64c6f5341ed968651dee547b417 of
#: pybroker.context.ExecContext.cancel_pending_order:1
msgid "Cancels a :class:`pybroker.scope.PendingOrder` with ``order_id``."
msgstr "取消 ID 为 ``order_id`` 的 :class:`pybroker.scope.PendingOrder`。"

#: 44020fc84ccb493fb5a4d6bbe840b14b of
#: pybroker.context.ExecContext.cancel_stop:1
msgid "Cancels a :class:`pybroker.portfolio.Stop` with ``stop_id``."
msgstr "取消 ID 为 ``stop_id`` 的 :class:`pybroker.portfolio.Stop`。"

#: 4d02cc70f282429c8322a5c8ad8a348f of
#: pybroker.context.ExecContext.cancel_stops:1
msgid "Cancels :class:`pybroker.portfolio.Stop`\\ s."
msgstr "取消 :class:`pybroker.portfolio.Stop`\\。"

#: a2f884edf8e8472c90941c244617bfad of
#: pybroker.context.ExecContext.cancel_stops:3
msgid ""
"Ticker symbol, :class:`pybroker.portfolio.Position`, or "
":class:`pybroker.portfolio.Entry` for which to cancel stops."
msgstr ""
"要取消止损的股票代码、:class:`pybroker.portfolio.Position` 或 "
":class:`pybroker.portfolio.Entry`。"

#: 5fb9d15d065d446aa9a7ae9fd252faf0 of
#: pybroker.context.ExecContext.cancel_stops:5
msgid ":class:`pybroker.common.StopType`."
msgstr ":class:`pybroker.common.StopType`。"

#: 572116c2d7cf411498d3d24d7fb6a190 of pybroker.context.ExecContext.cash:1
msgid "Total cash currently held in the :class:`pybroker.portfolio.Portfolio`."
msgstr ":class:`pybroker.portfolio.Portfolio` 中当前持有的现金总额。"

#: f34befcf97a943a9ba0f24ba810ef883 of pybroker.context.ExecContext.close:1
msgid "Current bar's close price."
msgstr "当前 K 线的收盘价。"

#: 2030c8db99ed435690ea28da7bea6990 of
#: pybroker.context.ExecContext.close_price:1
msgid "Current bar's close price as a scalar."
msgstr "当前 K 线的收盘价（标量形式）。"

#: 12f4d3600d5043f1b9705a21e0d7f9fd of
#: pybroker.context.ExecContext.cover_all_shares:1
msgid "Covers all short shares of :attr:`.ExecContext.symbol`."
msgstr "回补 :attr:`.ExecContext.symbol` 的全部空头股份。"

#: 7f9500f9152148f8a8b75e54832a78da of
#: pybroker.context.ExecContext.cover_fill_price:1
msgid ""
"Alias for :attr:`.buy_fill_price`. When set, this causes the buy order to"
" be placed before any sell orders."
msgstr ":attr:`.buy_fill_price` 的别名。设置后，会使买入订单在任何卖出订单之前下达。"

#: f642246f482b470698c7d26a8cb02caa of
#: pybroker.context.ExecContext.cover_limit_price:1
msgid ""
"Alias for :attr:`.buy_limit_price`. When set, this causes the buy order "
"to be placed before any sell orders."
msgstr ":attr:`.buy_limit_price` 的别名。设置后，会使买入订单在任何卖出订单之前下达。"

#: 59459cfc0cb6403985d201e902cffd72 of
#: pybroker.context.ExecContext.cover_shares:1
msgid ""
"Alias for :attr:`.buy_shares`. When set, this causes the buy order to be "
"placed before any sell orders."
msgstr ":attr:`.buy_shares` 的别名。设置后，会使买入订单在任何卖出订单之前下达。"

#: 2465dcbc4dba4d2290e392d14f087e2d of pybroker.context.ExecContext.dt:1
msgid "Current bar's date expressed as a ``datetime``."
msgstr "以 ``datetime`` 表示的当前 K 线日期。"

#: 7ca2f70b63b9469fb7bc3b57967c2f22 of pybroker.context.ExecContext.foreign:1
msgid "Retrieves bar data for another ticker symbol."
msgstr "获取另一个股票代码的 K 线数据。"

#: 0122f93e34c14d0ab5034c64acf80217 of pybroker.context.ExecContext.foreign:3
msgid "Ticker symbol of the bar data."
msgstr "该 K 线数据的股票代码。"

